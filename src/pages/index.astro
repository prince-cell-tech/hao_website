---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Destinations from '../components/Destinations.astro';
import Tours from '../components/Tours.astro';
import About from '../components/About.astro';
import Experience from '../components/Experience.astro';
import Testimonials from '../components/Testimonials.astro';
import Team from '../components/Team.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="HAO Expedition & Safari — All Destination Africa"
  description="Luxury safari and expedition experiences across East Africa. Serengeti, Kilimanjaro, Zanzibar and beyond. Small groups, expert guides, unforgettable wilderness."
>
  <Nav />
  <main>
    <Hero />
    <Destinations />
    <Tours />
    <About />
    <Experience />
    <Testimonials />
    <Team />
    <Contact />
  </main>
  <Footer />
</Layout>
